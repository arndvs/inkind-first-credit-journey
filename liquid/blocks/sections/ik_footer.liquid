{%- comment -%}
  ik_footer: the footer every marketing email shares.
  Inputs: none beyond ik_brand and ik_urls.
  Outputs: none.
  Notes: logo, legal name and address, social and website icons, then unsubscribe,
  preferences, privacy, and terms. A social icon appears only when its profile URL is set.
  The preference center tag needs its name written literally; inkind_email_preferences is
  illustrative. Braze's docs say to avoid the older ${preference_center_url} tag.
{%- endcomment -%}
<table class="row-content" align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" width="{{ ik_width }}" style="background-color:{{ ik_color_black }};width:{{ ik_width }}px;margin:0 auto"><tbody>
<tr><td style="padding:{{ ik_space_xl }}px {{ ik_space_xs }}px {{ ik_space_xs }}px" align="center"><div style="max-width:85px"><img alt="{{ ik_brand_name }}" src="{{ ik_logo_url }}" style="display:block;border:0;width:100%" width="85"></div></td></tr>
<tr><td style="padding:{{ ik_space_xs }}px;text-align:center;color:{{ ik_color_white }};font-family:{{ ik_font }};font-size:{{ ik_text_xs }}px">© {{ 'now' | date: '%Y' }} {{ ik_company_name }}<br>{{ ik_company_address }}</td></tr>
<tr><td style="padding:{{ ik_space_xs }}px;font-size:0;line-height:0" align="center">
  {%- if tiktok_url != blank %}<a href="{{ tiktok_url }}" target="_blank" style="display:inline-block;padding:0 {{ ik_space_xs }}px"><img alt="TikTok" src="{{ ik_icon_tiktok_url }}" width="40" style="display:block;border:0;width:40px"></a>{% endif -%}
  {%- if facebook_url != blank %}<a href="{{ facebook_url }}" target="_blank" style="display:inline-block;padding:0 {{ ik_space_xs }}px"><img alt="Facebook" src="{{ ik_icon_facebook_url }}" width="40" style="display:block;border:0;width:40px"></a>{% endif -%}
  {%- if instagram_url != blank %}<a href="{{ instagram_url }}" target="_blank" style="display:inline-block;padding:0 {{ ik_space_xs }}px"><img alt="Instagram" src="{{ ik_icon_instagram_url }}" width="40" style="display:block;border:0;width:40px"></a>{% endif -%}
  <a href="{{ explore_url }}" target="_blank" style="display:inline-block;padding:0 {{ ik_space_xs }}px"><img alt="{{ ik_brand_name }} website" src="{{ ik_icon_website_url }}" width="40" style="display:block;border:0;width:40px"></a>
</td></tr>
<tr><td style="padding:{{ ik_space_sm }}px {{ ik_space_xs }}px {{ ik_space_lg }}px;text-align:center;font-family:{{ ik_font }};font-size:{{ ik_text_sm }}px;color:{{ ik_color_white }}">
  <a href="{{ ${set_user_to_unsubscribed_url} }}" style="color:{{ ik_color_white }};text-decoration:none">Unsubscribe</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="{{preference_center.${inkind_email_preferences}}}" style="color:{{ ik_color_white }};text-decoration:none">Preferences</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="{{ privacy_url }}" style="color:{{ ik_color_white }};text-decoration:none">Privacy Policy</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="{{ terms_url }}" style="color:{{ ik_color_white }};text-decoration:none">Terms</a>
</td></tr></tbody></table>
