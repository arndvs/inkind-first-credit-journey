{%- comment -%}
  ik_urls: every link the library builds starts here.
  Inputs: none.
  Outputs: explore_url, restaurant_base_url, privacy_url, terms_url, tiktok_url, facebook_url, instagram_url.
  Notes: restaurant links are restaurant_base_url plus a location_id. Social profile URLs are
  blank until confirmed; the footer shows an icon only when its URL is set.
{%- endcomment -%}
{%- assign explore_url = 'https://www.inkind.com' -%}
{%- assign restaurant_base_url = 'https://app.inkind.com/map?location=' -%}
{%- assign privacy_url = 'https://inkind.com/privacy' -%}
{%- assign terms_url = 'https://inkind.com/terms' -%}
{%- assign tiktok_url = '' -%}
{%- assign facebook_url = '' -%}
{%- assign instagram_url = '' -%}
