{%- comment -%}
  ik_layout_open: document head, mobile CSS, preheader, and the outer table.
  Inputs: page_title, preheader.
  Outputs: none. Close with ik_layout_close.
  Notes: declares a light color scheme only. There are no dark styles, so declaring
  "light dark" would invite clients to invert colors unpredictably.
{%- endcomment -%}
<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ page_title | escape }}</title>
<!--[if !mso]><!--><link href="https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;600;800&amp;display=swap" rel="stylesheet" type="text/css"><!--<![endif]-->
<style>
:root{color-scheme:light;supported-color-schemes:light}
*{box-sizing:border-box}body{margin:0;padding:0}a[x-apple-data-detectors]{color:inherit!important;text-decoration:inherit!important}p{line-height:inherit}
@media (max-width:620px){.row-content{width:100%!important}.button{width:95%!important}.pad-x{padding-left:{{ ik_space_sm }}px!important;padding-right:{{ ik_space_sm }}px!important}}
</style>
</head>
<body style="margin:0;padding:0;-webkit-text-size-adjust:none;text-size-adjust:none;background-color:{{ ik_color_white }}">
<div style="display:none;visibility:hidden;mso-hide:all;font-size:1px;color:{{ ik_color_white }};line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden">{{ preheader | escape }}</div>
<table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color:{{ ik_color_white }}"><tbody><tr><td>
